# Local development example. Store real secrets in your shell or a secret manager.
# Generate a fresh key with:
# python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())'
DJANGO_SECRET_KEY=replace-with-a-local-only-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,testserver
DJANGO_DB_ENGINE=sqlite
DJANGO_DB_NAME=

DJANGO_CSRF_TRUSTED_ORIGINS=

# Production example: configure these in the hosting provider's secret manager.
# Non-debug deployments require PostgreSQL and certificate-verifying TLS.
# DJANGO_DEBUG=false
# DJANGO_SECRET_KEY=replace-with-a-unique-production-secret
# DJANGO_ALLOWED_HOSTS=your-production-host.example
# DJANGO_DB_ENGINE=postgresql
# DJANGO_DB_NAME=renais
# DJANGO_DB_USER=renais_app
# DJANGO_DB_PASSWORD=
# DJANGO_DB_HOST=your-private-postgresql-host
# DJANGO_DB_PORT=5432
# DJANGO_DB_SSLMODE=verify-full
# DJANGO_DB_SSLROOTCERT=/path/to/provider-ca.pem
# DJANGO_DB_CONN_MAX_AGE=60

# Trust only a reverse proxy that controls X-Forwarded-Proto.
DJANGO_TRUST_PROXY=false
# Keep HSTS disabled until the production domain and subdomains are HTTPS-ready.
DJANGO_HSTS_SECONDS=0
DJANGO_HSTS_INCLUDE_SUBDOMAINS=false
DJANGO_HSTS_PRELOAD=false
