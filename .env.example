# Copy these values into your deployment environment; do not commit real secrets.
# Generate with: python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())'
# The key must be at least 50 characters and contain at least 5 distinct characters.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
# Optional PostgreSQL configuration; omit DJANGO_DB_ENGINE to use SQLite.
DJANGO_DB_ENGINE=
DJANGO_DB_NAME=
DJANGO_DB_USER=
DJANGO_DB_PASSWORD=
DJANGO_DB_HOST=
DJANGO_DB_PORT=

# Trust only a reverse proxy that controls X-Forwarded-Proto.
DJANGO_TRUST_PROXY=false
# Keep HSTS disabled until the production domain and subdomains are HTTPS-ready.
DJANGO_HSTS_SECONDS=0
DJANGO_HSTS_INCLUDE_SUBDOMAINS=false
DJANGO_HSTS_PRELOAD=false
