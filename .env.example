# Copy these values into your deployment environment; do not commit real secrets.
DJANGO_SECRET_KEY=replace-with-a-new-random-secret
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
# Optional PostgreSQL configuration; omit DJANGO_DB_ENGINE to use SQLite.
DJANGO_DB_ENGINE=
DJANGO_DB_NAME=
DJANGO_DB_USER=
DJANGO_DB_PASSWORD=
DJANGO_DB_HOST=
DJANGO_DB_PORT=
